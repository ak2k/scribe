// Run by an Audio Hijack session automation on the Session Stop event.
// Transcribes the newest "mic" and "app" recordings of this session and merges them.
// #needsSession
const log = '"$HOME/Library/Logs/scribe-call.log"';
const q = (s) => app.shellEscapeArgument(s);
const stem = (r) => r.fileName.replace(/\.[^.]*$/, "");
const newest = (suffix) =>
  event.session.recordings
    .filter((r) => stem(r).endsWith(suffix))
    .sort((a, b) => new Date(b.creationDate) - new Date(a.creationDate))[0];
const mic = newest("mic");
const far = newest("app");
app.runShellCommand(
  "echo \"$(date) stop: mic=\"" + q(mic ? mic.filePath : "none") + "\" app=\"" + q(far ? far.filePath : "none") +
    " >> " + log
);
if (mic && far) {
  // runShellCommand blocks Audio Hijack until it returns, so the work runs detached. An app's
  // PATH lacks the user's profile, where transcribe finds the claude CLI it picks with. No shell
  // profile is read either, so the scribe found here must supply XAI_API_KEY itself, for
  // example a wrapper script that reads the key from a file and runs scribe.
  const work =
    "PATH=\"$HOME/.local/bin:/etc/profiles/per-user/$USER/bin:$HOME/.nix-profile/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin\"; export PATH; " +
    "scribe transcribe \"$1\" --no-diarize && scribe transcribe \"$2\" && " +
    "scribe merge \"${1%.*}.transcript.json\" \"${2%.*}.transcript.json\"";
  app.runShellCommand(
    "nohup /bin/sh -c " + q(work) + " sh " + q(mic.filePath) + " " + q(far.filePath) +
      " < /dev/null >> " + log + " 2>&1 &"
  );
}
