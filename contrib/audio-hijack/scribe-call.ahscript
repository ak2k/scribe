// Run by an Audio Hijack session automation on the Session Stop event.
// Transcribes the newest "mic" recording of this session and its "app" partner, merges them and
// writes the merged transcript as speaker turns.
// #needsSession
const log = '"$HOME/Library/Logs/scribe-call.log"';
const q = (s) => app.shellEscapeArgument(s);
const stem = (r) => r.fileName.replace(/\.[^.]*$/, "");
// Audio Hijack runs each command as /bin/sh -c from / with no environment variables, so every
// command first sets HOME and USER (unless given) and PATH and exports them to what it starts.
// With no HOME passed, the home comes from the user database through ~user.
// The PATH holds the directories where scribe and the tools it runs (claude, uvx) are installed.
const env =
  "[ -n \"${HOME:-}\" ] || eval \"HOME=~$(/usr/bin/id -un)\"; " +
  "USER=\"${USER:-$(/usr/bin/id -un)}\"; " +
  "PATH=\"$HOME/.local/bin:/etc/profiles/per-user/$USER/bin:$HOME/.nix-profile/bin:" +
  "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin\"; export HOME USER PATH; ";
// A second run in the same minute is named "... mic 2" and "... app 2".
const MIC = / mic( \d+)?$/;
(() => {
  // A manual run from the Script Library has no session.
  if (!event.session) {
    app.runShellCommand(
      env + "printf '%s no session: event %s\\n' \"$(date)\" " + q(String(event.eventType)) +
        " >> " + log
    );
    return;
  }
  const recs = event.session.recordings;
  const mic = recs
    .filter((r) => MIC.test(stem(r)))
    .sort((a, b) => new Date(b.creationDate) - new Date(a.creationDate))[0];
  const far = mic && recs.find((r) => stem(r) === stem(mic).replace(MIC, " app$1"));
  app.runShellCommand(
    env + "printf '%s stop: mic=%s app=%s\\n' \"$(date)\" " + q(mic ? mic.filePath : "none") +
      " " + q(far ? far.filePath : "none") + " >> " + log
  );
  if (mic && far) {
    // runShellCommand blocks Audio Hijack until it returns, so the work runs detached and at low
    // priority. It skips a pair already merged: a stop that made no new mic recording picks the
    // previous call again. No shell profile is read, so the scribe found on PATH must supply
    // XAI_API_KEY itself, such as a wrapper script that reads the key from a file and runs scribe.
    const work =
      "[ -e \"${1%.*}.merged.json\" ] && { printf '%s skip: %s is already merged\\n' \"$(date)\" \"$1\"; exit 0; }; " +
      "scribe transcribe \"$1\" --no-diarize && scribe transcribe \"$2\" && " +
      "scribe merge \"${1%.*}.transcript.json\" \"${2%.*}.transcript.json\" && " +
      "scribe turns \"${1%.*}.merged.json\"; " +
      "s=$?; printf '%s end %s: %s\\n' \"$(date)\" \"$s\" \"$1\"";
    app.runShellCommand(
      env + "nohup /usr/bin/nice -n 19 /bin/sh -c " + q(work) + " sh " + q(mic.filePath) + " " +
        q(far.filePath) + " < /dev/null >> " + log + " 2>&1 &"
    );
  }
})();
